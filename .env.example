# ---- Database ----
DATABASE_URL=postgres://qitaa:qitaa@localhost:5432/qitaa

# ---- Object storage (tiles, listing media) ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qitaa-tiles
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_BUILDINGS_PMTILES=/data/amman-buildings.pmtiles
# Set to 1 to run the map + invest flow with bundled fixture data (no API/DB needed)
NEXT_PUBLIC_DEMO_MODE=1

# ---- Compliance / KYC (Phase 2) ----
KYC_PROVIDER=uqudo
KYC_API_KEY=
# CBJ-licensed PSP for JOD collection (eFAWATEERcom / CliQ / mPSP wallet)
PSP_PROVIDER=madfooatcom
PSP_MERCHANT_ID=
